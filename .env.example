# Copy to .env and change every value. Never commit .env.
DB_PASSWORD=change-me
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-bytes
ADMIN_USERNAME=admin
# At least 12 characters. Used only when the user table is empty.
ADMIN_PASSWORD=change-me-please
# true behind HTTPS. Set false only for plain-http runs on localhost.
COOKIE_SECURE=true
# The exact origin users open in the browser.
ALLOWED_ORIGINS=http://localhost:8088
HTTP_PORT=8088
