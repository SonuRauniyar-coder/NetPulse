<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProfile name="prod">
        <!-- Structured JSON logs; MDC (incl. correlationId) is emitted as top-level fields. -->
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
        <root level="INFO"><appender-ref ref="JSON"/></root>
    </springProfile>

    <springProfile name="!prod">
        <property name="CONSOLE_LOG_PATTERN"
                  value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{correlationId:-}] %cyan(%logger{36}) - %msg%n"/>
        <appender name="DEV" class="ch.qos.logback.core.ConsoleAppender">
            <encoder><pattern>${CONSOLE_LOG_PATTERN}</pattern></encoder>
        </appender>
        <root level="INFO"><appender-ref ref="DEV"/></root>
    </springProfile>
</configuration>
